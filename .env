# Sanity Configuration
EXPO_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here
EXPO_PUBLIC_SANITY_DATASET=production
EXPO_PUBLIC_SANITY_API_VERSION=2024-01-01

# For migration script (get token from https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api#tokens)
EXPO_PUBLIC_SANITY_TOKEN=your_sanity_token_here

# Clerk Configuration (get from https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Keep old names for studio/scripts
SANITY_PROJECT_ID=your_sanity_project_id_here
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_TOKEN=your_sanity_token_here
STRIPE_PUBLIC_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# API Configuration (your backend server URL)
# For local development, use ngrok or similar to expose your local server
EXPO_PUBLIC_API_URL=https://your-api-url.vercel.app
